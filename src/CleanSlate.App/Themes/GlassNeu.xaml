<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette -->
    <Color x:Key="BgCanvasColor">#E8EEF5</Color>
    <Color x:Key="InkPrimaryColor">#0F1C2E</Color>
    <Color x:Key="InkSecondaryColor">#3D5168</Color>
    <Color x:Key="AccentColor">#2F9CFF</Color>
    <Color x:Key="SuccessColor">#18A673</Color>
    <Color x:Key="WarningColor">#E6A100</Color>
    <Color x:Key="DangerColor">#E24B4A</Color>
    <Color x:Key="NeuSurfaceColor">#EDF3F9</Color>

    <SolidColorBrush x:Key="BgCanvasBrush" Color="{StaticResource BgCanvasColor}" />
    <SolidColorBrush x:Key="InkPrimaryBrush" Color="{StaticResource InkPrimaryColor}" />
    <SolidColorBrush x:Key="InkSecondaryBrush" Color="{StaticResource InkSecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="NeuSurfaceBrush" Color="{StaticResource NeuSurfaceColor}" />

    <!-- Glass panel -->
    <Style x:Key="GlassPanel" TargetType="Border">
        <Setter Property="Background" Value="#6CFFFFFF" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="BorderBrush" Value="#8CFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.12" Color="#0F1C2E" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassPanelStrong" TargetType="Border" BasedOn="{StaticResource GlassPanel}">
        <Setter Property="Background" Value="#99FFFFFF" />
        <Setter Property="CornerRadius" Value="24" />
    </Style>

    <!-- Neumorphism raised button -->
    <Style x:Key="NeuButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource NeuSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="14"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="5" Direction="315" Opacity="0.4" Color="#8CA5C3" />
                        </Border.Effect>
                        <Border x:Name="Inner" Background="Transparent" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.94" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#E4EBF3" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary / Danger buttons -->
    <Style x:Key="NeuButtonPrimary" TargetType="Button" BasedOn="{StaticResource NeuButton}">
        <Setter Property="Foreground" Value="#0B3A66" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="#D0E8FF" CornerRadius="14" Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="315" Opacity="0.35" Color="#2F9CFF" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NeuButtonDanger" TargetType="Button" BasedOn="{StaticResource NeuButton}">
        <Setter Property="Foreground" Value="#8B1E1E" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="#F8D7D7" CornerRadius="14" Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="315" Opacity="0.35" Color="#E24B4A" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inset search / input -->
    <Style x:Key="NeuTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#E4EBF3" />
        <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="45" Opacity="0.4" Color="#8CA5C3" />
                        </Border.Effect>
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Risk badge -->
    <Style x:Key="RiskBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Margin" Value="6,0,0,0" />
    </Style>

    <Style x:Key="RiskBadgeLow" TargetType="Border" BasedOn="{StaticResource RiskBadge}">
        <Setter Property="Background" Value="#D9F3E8" />
        <Setter Property="Tag" Value="低风险" />
    </Style>

    <Style x:Key="RiskBadgeMedium" TargetType="Border" BasedOn="{StaticResource RiskBadge}">
        <Setter Property="Background" Value="#FFF0C9" />
    </Style>

    <Style x:Key="RiskBadgeHigh" TargetType="Border" BasedOn="{StaticResource RiskBadge}">
        <Setter Property="Background" Value="#F8D7D7" />
    </Style>

    <Style x:Key="RiskBadgeProtected" TargetType="Border" BasedOn="{StaticResource RiskBadge}">
        <Setter Property="Background" Value="#D5DDE8" />
    </Style>

    <!-- Software list row -->
    <Style x:Key="SoftwareRow" TargetType="Border">
        <Setter Property="Background" Value="#55FFFFFF" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
    </Style>

    <!-- Nav item -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Padding="14,12">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#B0FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
