<Window x:Class="CleanSlate.App.DisclaimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="简卸 — 使用须知"
        Width="640" Height="560"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgCanvasBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/GlassNeu.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Border Style="{StaticResource GlassPanelStrong}" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="免责声明与使用须知" Style="{StaticResource TitleText}" />
                    <TextBlock Style="{StaticResource CaptionText}"
                               Text="CleanSlate 本地卸载与残留清理工具 · 使用前请仔细阅读" />
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource GlassPanel}" Padding="16" Background="#55FFFFFF">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="DisclaimerBody" Style="{StaticResource BodyText}"
                                   TextWrapping="Wrap" LineHeight="22"
                                   Text="加载中…" />
                    </ScrollViewer>
                </Border>

                <CheckBox x:Name="ChkAgree" Grid.Row="2" Margin="0,12,0,8"
                          Content="我已阅读并理解上述免责说明，自愿使用本软件，并知晓清理操作的风险。"
                          FontWeight="SemiBold" />

                <DockPanel Grid.Row="3">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center"
                               Text="不同意将退出程序" />
                    <Button x:Name="BtnAgree" DockPanel.Dock="Right" Content="同意并开始使用"
                            Style="{StaticResource NeuButtonPrimary}" IsEnabled="False"
                            Margin="8,0,0,0" Click="BtnAgree_Click" />
                    <Button x:Name="BtnDecline" DockPanel.Dock="Right" Content="不同意，退出"
                            Style="{StaticResource NeuButton}" Click="BtnDecline_Click" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
