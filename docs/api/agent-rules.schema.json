{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cleanslate.local/schemas/agent-rules.json",
  "title": "CleanSlate Agent Cleanup Rules",
  "type": "object",
  "required": ["schemaVersion", "rules"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["agentId", "displayName", "processNames", "pathPatterns", "layers"],
        "properties": {
          "agentId": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string" },
          "processNames": {
            "type": "array",
            "items": { "type": "string" }
          },
          "pathPatterns": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Supports %LOCALAPPDATA%, %APPDATA%, %USERPROFILE% env-style tokens and * wildcards"
          },
          "layers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "risk", "defaultSelected"],
              "properties": {
                "name": {
                  "type": "string",
                  "enum": ["L1Cache", "L2Session", "L3Config", "L4Credential", "L5Model"]
                },
                "risk": {
                  "type": "string",
                  "enum": ["Low", "Medium", "High", "Protected"]
                },
                "defaultSelected": { "type": "boolean" },
                "notes": { "type": "string" }
              }
            }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
